# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/reachinbox

# Redis
REDIS_URL=redis://localhost:6379

# BullMQ
EMAIL_QUEUE_NAME=email-queue
WORKER_CONCURRENCY=5
WORKER_ATTEMPTS=3
WORKER_BACKOFF_MS=5000
ENABLE_WORKER=true

# Rate limiting (per sender per hour)
EMAILS_PER_HOUR=100

# Minimum delay between sends (ms)
MIN_DELAY_MS=500

# Google OAuth (for user authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_AUDIENCE=

# SMTP Configuration
# For Gmail: smtp.gmail.com, port 587, secure=false
# For Ethereal (testing): smtp.ethereal.email, port 587, secure=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

